# Sem estas duas variáveis o site abre em modo demo (tudo no browser).
# Com elas, usa o projeto Supabase: contas reais, Discord e a máquina de estados na base de dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: o link da extensão do browser (Chrome Web Store ou Edge Add-ons). Com ele, a página Jogar convida
# a instalá-la a quem ainda não a tem. Ver extensao/PUBLICAR.md.
VITE_EXTENSAO_URL=
