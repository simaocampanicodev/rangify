{
  "manifest_version": 3,
  "name": "Rangify: fila e aviso de partida",
  "short_name": "Rangify",
  "version": "1.1.0",
  "description": "A roda da fila do Rangify no browser: entra e sai da fila e ouve o aviso de partida encontrada mesmo que estejas noutro separador, no YouTube por exemplo.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "Rangify",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5175/*"
      ],
      "js": [
        "content/ponte.js"
      ],
      "run_at": "document_start"
    }
  ]
}
